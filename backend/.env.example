# Environment
APP_ENV=development
APP_DEBUG=true

# Server
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./verifyai.db

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
APP_TITLE=AICTE VerifyAI
APP_VERSION=0.3.0

# Document Storage & Upload Limits
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=10485760

# OCR Engine (Optional custom binary path for Windows, e.g., C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
